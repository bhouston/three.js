<?xml version="1.0"?>
<materialx version="1.39">
  <gltf_pbr name="surface_shader1" type="surfaceshader">
    <input name="base_color" type="color3" value="0.12, 0.72, 0.28" />
    <input name="metallic" type="float" value="0.0" />
    <input name="roughness" type="float" value="0.65" />
    <input name="alpha" type="float" output="out" nodegraph="alpha_grid_graph" />
    <input name="alpha_mode" type="integer" value="1" />
    <input name="alpha_cutoff" type="float" value="0.5" />
  </gltf_pbr>
  <surfacematerial name="mat_neural_train_alpha_cutoff" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="surface_shader1" />
  </surfacematerial>
  <nodegraph name="alpha_grid_graph">
    <image name="alpha_grid" type="float">
      <input name="file" type="filename" value="resources/Images/grid.png" />
      <input name="default" type="float" value="1.0" />
    </image>
    <output name="out" type="float" nodename="alpha_grid" />
  </nodegraph>
</materialx>
