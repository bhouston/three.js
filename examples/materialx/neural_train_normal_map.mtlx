<?xml version="1.0"?>
<materialx version="1.39">
  <surfacematerial name="mat_neural_train_normal_map" type="material" nodedef="ND_surfacematerial">
    <input name="surfaceshader" type="surfaceshader" nodename="surface_shader1" />
  </surfacematerial>
  <standard_surface name="surface_shader1" type="surfaceshader" nodedef="ND_standard_surface_surfaceshader">
    <input name="base_color" type="color3" value="0.32, 0.48, 0.82" />
    <input name="specular" type="float" value="0.9" />
    <input name="specular_roughness" type="float" value="0.25" />
    <input name="metalness" type="float" value="0.0" />
    <input name="normal" type="vector3" output="out" nodegraph="normal_map_graph" />
  </standard_surface>
  <nodegraph name="normal_map_graph">
    <texcoord name="texcoord1" type="vector2" />
    <separate2 name="uv_components" type="vector2">
      <input name="in" type="vector2" nodename="texcoord1" />
    </separate2>
    <multiply name="u_phase" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outx" />
      <input name="in2" type="float" value="50.265482" />
    </multiply>
    <multiply name="v_phase" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outy" />
      <input name="in2" type="float" value="37.699112" />
    </multiply>
    <sin name="u_wave" type="float">
      <input name="in" type="float" nodename="u_phase" />
    </sin>
    <sin name="v_wave" type="float">
      <input name="in" type="float" nodename="v_phase" />
    </sin>
    <add name="combined_wave" type="float">
      <input name="in1" type="float" nodename="u_wave" />
      <input name="in2" type="float" nodename="v_wave" />
    </add>
    <multiply name="wave_amplitude" type="float">
      <input name="in1" type="float" nodename="combined_wave" />
      <input name="in2" type="float" value="0.25" />
    </multiply>
    <add name="height_wave" type="float">
      <input name="in1" type="float" nodename="wave_amplitude" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <heighttonormal name="tangent_normal" type="vector3">
      <input name="in" type="float" nodename="height_wave" />
      <input name="scale" type="float" value="1.5" />
      <input name="texcoord" type="vector2" nodename="texcoord1" />
    </heighttonormal>
    <normal name="geom_normal" type="vector3">
      <input name="space" type="string" value="object" />
    </normal>
    <tangent name="geom_tangent" type="vector3">
      <input name="space" type="string" value="object" />
    </tangent>
    <bitangent name="geom_bitangent" type="vector3">
      <input name="space" type="string" value="object" />
    </bitangent>
    <normalmap name="object_normal" type="vector3">
      <input name="in" type="vector3" nodename="tangent_normal" />
      <input name="scale" type="float" value="1.0" />
      <input name="normal" type="vector3" nodename="geom_normal" />
      <input name="tangent" type="vector3" nodename="geom_tangent" />
      <input name="bitangent" type="vector3" nodename="geom_bitangent" />
    </normalmap>
    <output name="out" type="vector3" nodename="object_normal" />
  </nodegraph>
</materialx>
