<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="wave_normal_graph">
    <texcoord name="texcoord1" type="vector2" />
    <separate2 name="uv_components" type="vector2">
      <input name="in" type="vector2" nodename="texcoord1" />
    </separate2>
    <multiply name="u_phase" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outx" />
      <input name="in2" type="float" value="50.265482" />
    </multiply>
    <multiply name="v_phase" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outy" />
      <input name="in2" type="float" value="37.699112" />
    </multiply>
    <sin name="u_wave" type="float">
      <input name="in" type="float" nodename="u_phase" />
    </sin>
    <sin name="v_wave" type="float">
      <input name="in" type="float" nodename="v_phase" />
    </sin>
    <add name="combined_wave" type="float">
      <input name="in1" type="float" nodename="u_wave" />
      <input name="in2" type="float" nodename="v_wave" />
    </add>
    <multiply name="wave_amplitude" type="float">
      <input name="in1" type="float" nodename="combined_wave" />
      <input name="in2" type="float" value="0.25" />
    </multiply>
    <add name="height_wave" type="float">
      <input name="in1" type="float" nodename="wave_amplitude" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <heighttonormal name="tangent_normal" type="vector3">
      <input name="in" type="float" nodename="height_wave" />
      <input name="scale" type="float" value="1.5" />
      <input name="texcoord" type="vector2" nodename="texcoord1" />
    </heighttonormal>
    <normalmap name="world_normal" type="vector3">
      <input name="in" type="vector3" nodename="tangent_normal" />
      <input name="scale" type="float" value="1.0" />
    </normalmap>
    <output name="out" type="vector3" nodename="world_normal" />
  </nodegraph>
  <nodegraph name="emissive_rainbow_graph">
    <texcoord name="texcoord1" type="vector2" />
    <separate2 name="uv_components" type="vector2">
      <input name="in" type="vector2" nodename="texcoord1" />
    </separate2>
    <multiply name="u_phase" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outx" />
      <input name="in2" type="float" value="25.132741" />
    </multiply>
    <multiply name="v_phase" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outy" />
      <input name="in2" type="float" value="12.566371" />
    </multiply>
    <add name="base_phase" type="float">
      <input name="in1" type="float" nodename="u_phase" />
      <input name="in2" type="float" nodename="v_phase" />
    </add>
    <add name="g_phase" type="float">
      <input name="in1" type="float" nodename="base_phase" />
      <input name="in2" type="float" value="2.094395" />
    </add>
    <add name="b_phase" type="float">
      <input name="in1" type="float" nodename="base_phase" />
      <input name="in2" type="float" value="4.188790" />
    </add>
    <sin name="sin_r" type="float">
      <input name="in" type="float" nodename="base_phase" />
    </sin>
    <sin name="sin_g" type="float">
      <input name="in" type="float" nodename="g_phase" />
    </sin>
    <sin name="sin_b" type="float">
      <input name="in" type="float" nodename="b_phase" />
    </sin>
    <multiply name="scaled_r" type="float">
      <input name="in1" type="float" nodename="sin_r" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <multiply name="scaled_g" type="float">
      <input name="in1" type="float" nodename="sin_g" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <multiply name="scaled_b" type="float">
      <input name="in1" type="float" nodename="sin_b" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <add name="r_channel" type="float">
      <input name="in1" type="float" nodename="scaled_r" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <add name="g_channel" type="float">
      <input name="in1" type="float" nodename="scaled_g" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <add name="b_channel" type="float">
      <input name="in1" type="float" nodename="scaled_b" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <combine3 name="emissive_color" type="color3">
      <input name="in1" type="float" nodename="r_channel" />
      <input name="in2" type="float" nodename="g_channel" />
      <input name="in3" type="float" nodename="b_channel" />
    </combine3>
    <output name="out" type="color3" nodename="emissive_color" />
  </nodegraph>
  <standard_surface name="SR_velvet_wave_rainbow" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" value="0.12, 0.03, 0.05" />
    <input name="specular" type="float" value="0" />
    <input name="specular_color" type="color3" value="0, 0, 0" />
    <input name="specular_roughness" type="float" value="0.693" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="sheen" type="float" value="1" />
    <input name="sheen_color" type="color3" value="1, 0.12, 0.18" />
    <input name="sheen_roughness" type="float" value="0.3" />
    <input name="normal" type="vector3" nodegraph="wave_normal_graph" output="out" />
    <input name="emission" type="float" value="0.6" />
    <input name="emission_color" type="color3" nodegraph="emissive_rainbow_graph" output="out" />
  </standard_surface>
  <surfacematerial name="M_velvet_wave_rainbow" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_velvet_wave_rainbow" />
  </surfacematerial>
</materialx>
